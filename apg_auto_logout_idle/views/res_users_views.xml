<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="res_users_view_form" model="ir.ui.view">
        <field name="name">res.users.view.form.inherit.auto.logout.idle.user.odoo</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!-- In 19.0 the `messaging` group no longer exists; `other_preferences`
                 is the designated override point of the Preferences page. -->
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <group string="IDLE TIMER">
                    <field name="enable_idle" />
                    <field name="idle_time" invisible="not enable_idle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
