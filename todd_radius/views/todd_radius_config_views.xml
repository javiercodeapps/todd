<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- NAS views -->
    <record id="todd_radius_nas_list" model="ir.ui.view">
        <field name="name">todd.radius.nas.list</field>
        <field name="model">todd.radius.nas</field>
        <field name="arch" type="xml">
            <list>
                <field name="nasname"/>
                <field name="shortname"/>
                <field name="type"/>
                <field name="ports"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="todd_radius_nas_form" model="ir.ui.view">
        <field name="name">todd.radius.nas.form</field>
        <field name="model">todd.radius.nas</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="nasname"/>
                            <field name="shortname"/>
                            <field name="type"/>
                            <field name="ports"/>
                        </group>
                        <group>
                            <field name="secret"/>
                            <field name="server"/>
                            <field name="community"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_todd_radius_nas" model="ir.actions.act_window">
        <field name="name">Servidores NAS</field>
        <field name="res_model">todd.radius.nas</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- radippool views -->
    <record id="todd_radius_radippool_list" model="ir.ui.view">
        <field name="name">todd.radius.radippool.list</field>
        <field name="model">todd.radius.radippool</field>
        <field name="arch" type="xml">
            <list>
                <field name="pool_name"/>
                <field name="framedipaddress"/>
                <field name="nasipaddress"/>
                <field name="username"/>
            </list>
        </field>
    </record>

    <record id="todd_radius_radippool_search" model="ir.ui.view">
        <field name="name">todd.radius.radippool.search</field>
        <field name="model">todd.radius.radippool</field>
        <field name="arch" type="xml">
            <search>
                <field name="pool_name"/>
                <field name="username"/>
            </search>
        </field>
    </record>

    <record id="action_todd_radius_ippool" model="ir.actions.act_window">
        <field name="name">Pool de IPs</field>
        <field name="res_model">todd.radius.radippool</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
