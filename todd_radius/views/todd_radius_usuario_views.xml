<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="todd_radius_userinfo_form" model="ir.ui.view">
        <field name="name">todd.radius.userinfo.form</field>
        <field name="model">todd.radius.userinfo</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_test_connection" type="object"
                            string="Test Conexión" class="oe_highlight"/>
                    <button name="action_reconfigurar_fdw" type="object"
                            string="Reconfigurar FDW"/>
                    <button name="action_diagnostico" type="object"
                            string="Diagnóstico"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="username"/>
                            <field name="firstname"/>
                            <field name="lastname"/>
                            <field name="email"/>
                            <field name="company"/>
                            <field name="mobilephone"/>
                            <field name="address"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="password" password="True"/>
                            <field name="groups_display"/>
                            <field name="ip_address"/>
                            <field name="is_online"/>
                            <field name="notes"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="tv"/>
                            <field name="tvuser"/>
                            <field name="tvpass"/>
                        </group>
                        <group>
                            <field name="creationdate"/>
                            <field name="updatedate"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="todd_radius_userinfo_list" model="ir.ui.view">
        <field name="name">todd.radius.userinfo.list</field>
        <field name="model">todd.radius.userinfo</field>
        <field name="arch" type="xml">
            <list>
                <field name="username"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="company"/>
                <field name="mobilephone"/>
                <field name="groups_display"/>
                <field name="ip_address"/>
                <field name="is_online"/>
            </list>
        </field>
    </record>

    <record id="todd_radius_userinfo_search" model="ir.ui.view">
        <field name="name">todd.radius.userinfo.search</field>
        <field name="model">todd.radius.userinfo</field>
        <field name="arch" type="xml">
            <search>
                <field name="username"/>
                <field name="firstname"/>
                <field name="lastname"/>
                <field name="company"/>
            </search>
        </field>
    </record>

    <record id="action_todd_radius_users" model="ir.actions.act_window">
        <field name="name">Usuarios RADIUS</field>
        <field name="res_model">todd.radius.userinfo</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- radusergroup views -->
    <record id="todd_radius_radusergroup_list" model="ir.ui.view">
        <field name="name">todd.radius.radusergroup.list</field>
        <field name="model">todd.radius.radusergroup</field>
        <field name="arch" type="xml">
            <list>
                <field name="username"/>
                <field name="groupname"/>
                <field name="priority"/>
            </list>
        </field>
    </record>

    <record id="todd_radius_radusergroup_search" model="ir.ui.view">
        <field name="name">todd.radius.radusergroup.search</field>
        <field name="model">todd.radius.radusergroup</field>
        <field name="arch" type="xml">
            <search>
                <field name="username"/>
                <field name="groupname"/>
                <group expand="0" string="Agrupar por">
                    <filter name="groupby_group" string="Grupo" context="{'group_by': 'groupname'}"/>
                    <filter name="groupby_user" string="Usuario" context="{'group_by': 'username'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_todd_radius_usergroups" model="ir.actions.act_window">
        <field name="name">Grupos de Usuarios</field>
        <field name="res_model">todd.radius.radusergroup</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
