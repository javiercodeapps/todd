<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_todd_radius_user" model="res.groups">
        <field name="name">Todd Radius / Usuario</field>
        <field name="category_id" ref="base.module_category_network"/>
    </record>

    <record id="group_todd_radius_manager" model="res.groups">
        <field name="name">Todd Radius / Administrador</field>
        <field name="category_id" ref="base.module_category_network"/>
        <field name="implied_ids" eval="[(4, ref('group_todd_radius_user'))]"/>
    </record>

    <record id="group_todd_radius_technical" model="res.groups">
        <field name="name">Todd Radius / Técnico</field>
        <field name="category_id" ref="base.module_category_network"/>
        <field name="implied_ids" eval="[(4, ref('group_todd_radius_user'))]"/>
    </record>
</odoo>
