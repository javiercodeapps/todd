<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_facturas" name="Mis Facturas">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>
            <t t-if="facturas">
                <div class="mb-3 text-muted">
                    Mostrando <t t-out="page_start"/> - <t t-out="page_end"/> de <t t-out="total"/> facturas
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Servicio</th>
                            <th>Período</th>
                            <th>Fecha</th>
                            <th>Vencimiento</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="facturas" t-as="f">
                            <tr>
                                <td><t t-esc="f.name"/></td>
                                <td>
                                    <t t-if="f.todd_servicio == 'E'"><span class="rounded px-2 py-1" style="background-color:#FF6B6B;color:#fff;">Energía</span></t>
                                    <t t-elif="f.todd_servicio == 'A'"><span class="rounded px-2 py-1" style="background-color:#4ECDC4;color:#fff;">Agua</span></t>
                                    <t t-elif="f.todd_servicio == 'T'"><span class="rounded px-2 py-1" style="background-color:#45B7D1;color:#fff;">Telefonía</span></t>
                                    <t t-elif="f.todd_servicio == 'I'"><span class="rounded px-2 py-1" style="background-color:#96CEB4;color:#fff;">Internet</span></t>
                                    <t t-elif="f.todd_servicio == 'S'"><span class="rounded px-2 py-1" style="background-color:#9B59B6;color:#fff;">Sepelio</span></t>
                                    <t t-elif="f.todd_servicio == 'N'"><span class="rounded px-2 py-1" style="background-color:#F39C12;color:#fff;">Nichos</span></t>
                                </td>
                                <td><t t-if="f.todd_periodo and len(f.todd_periodo) == 6"><t t-out="f.todd_periodo[4:6]"/>/<t t-out="f.todd_periodo[0:4]"/></t></td>
                                <td><t t-esc="f.invoice_date" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.invoice_date_due" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.amount_total" t-options="{'widget':'monetary','display_currency':f.currency_id}"/></td>
                                <td>
                                    <span t-if="f.todd_estado_pago == 'pagado'" class="badge bg-success">Pagado</span>
                                    <span t-else="" class="badge bg-danger">Adeudado</span>
                                </td>
                                <td>
                                    <t t-if="f.todd_pdf_disponible">
                                        <a t-attf-href="/my/factura/{{f.id}}/pdf" class="btn btn-sm btn-primary">PDF</a>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <!-- Paginación -->
                <t t-if="total_pages > 1">
                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item" t-att-class="'disabled' if page == 1 else ''">
                                <a class="page-link" t-attf-href="/my/facturas?page={{page - 1}}">Anterior</a>
                            </li>
                            <t t-foreach="range(1, total_pages + 1)" t-as="p">
                                <li class="page-item" t-att-class="'active' if p == page else ''">
                                    <a class="page-link" t-attf-href="/my/facturas?page={{p}}"><t t-out="p"/></a>
                                </li>
                            </t>
                            <li class="page-item" t-att-class="'disabled' if page == total_pages else ''">
                                <a class="page-link" t-attf-href="/my/facturas?page={{page + 1}}">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </t>
            </t>
            <t t-else="">
                <p class="text-center">No tienes facturas.</p>
            </t>
        </t>
    </template>
</odoo>