<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_facturas" name="Mis Facturas">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>
            <h2 class="mb-4" t-out="partner_name"/>
            <t t-if="facturas">
                <div class="mb-3 text-muted">
                    Mostrando <t t-out="page_start"/> - <t t-out="page_end"/> de <t t-out="total"/> facturas
                </div>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Servicio</th>
                            <th>Domicilio</th>
                            <th>Período</th>
                            <th>Fecha</th>
                            <th>Vencimiento</th>
                            <th>Total</th>
                            <th>Estado</th>
			    <th>Descargar/Pagar</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="facturas" t-as="f">
                            <tr>
                                <td><t t-esc="f.numero_completo"/></td>
                                <td>
                                    <t t-if="f.servicio == 'E'"><span class="rounded px-2 py-1" style="background-color:#FF6B6B;color:#fff;">Energía</span></t>
                                    <t t-elif="f.servicio == 'A'"><span class="rounded px-2 py-1" style="background-color:#4ECDC4;color:#fff;">Agua</span></t>
                                    <t t-elif="f.servicio == 'T'"><span class="rounded px-2 py-1" style="background-color:#45B7D1;color:#fff;">Telefonía</span></t>
                                    <t t-elif="f.servicio == 'I'"><span class="rounded px-2 py-1" style="background-color:#96CEB4;color:#fff;">Internet</span></t>
                                    <t t-elif="f.servicio == 'S'"><span class="rounded px-2 py-1" style="background-color:#9B59B6;color:#fff;">Sepelio</span></t>
                                    <t t-elif="f.servicio == 'N'"><span class="rounded px-2 py-1" style="background-color:#F39C12;color:#fff;">Nichos</span></t>
                                </td>
                                <td><t t-esc="f.domicilio"/></td>
                                <td><t t-if="f.periodo and len(f.periodo) == 6"><t t-out="f.periodo[4:6]"/>/<t t-out="f.periodo[0:4]"/></t></td>
                                <td><t t-esc="f.fecha_emision" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.fecha_vencimiento" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.importe" t-options="{'widget':'monetary','display_currency':f.env.company.currency_id}"/></td>
                                <td>
                                    <span t-if="f.estado_pago == 'pagado'" class="badge bg-success">Pagado</span>
                                    <span t-else="" class="badge bg-danger">Adeudado</span>
                                </td>
                                <td>
                                    <a t-attf-href="/my/factura/{{f.id}}/pdf" class="btn btn-sm btn-outline-primary" title="PDF">
                                        <i class="fa fa-file-pdf-o"/>
                                    </a>
                                    <t t-if="f.estado_pago != 'pagado'">
                                        <a t-attf-href="/my/factura/{{f.id}}/pago" class="btn btn-sm btn-success" title="Pagar">
                                            <i class="fa fa-credit-card"/> Pagar
                                        </a>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                <!-- Paginación -->
                <t t-if="total_pages > 1">
                    <nav>
                        <ul class="pagination justify-content-center">
                            <li class="page-item" t-att-class="'disabled' if page == 1 else ''">
                                <a class="page-link" t-attf-href="/my/facturas?page={{page - 1}}">Anterior</a>
                            </li>
                            <t t-foreach="range(1, total_pages + 1)" t-as="p">
                                <li class="page-item" t-att-class="'active' if p == page else ''">
                                    <a class="page-link" t-attf-href="/my/facturas?page={{p}}"><t t-out="p"/></a>
                                </li>
                            </t>
                            <li class="page-item" t-att-class="'disabled' if page == total_pages else ''">
                                <a class="page-link" t-attf-href="/my/facturas?page={{page + 1}}">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                </t>
            </t>
            <t t-else="">
                <p class="text-center">No tienes facturas.</p>
            </t>
        </t>
    </template>

    <!-- Página de pago -->
    <template id="portal_pago" name="Pago de Factura">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <!-- Factura -->
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h4 class="mb-0">Factura <t t-esc="factura.numero_completo"/></h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <table class="table table-borderless">
                                            <tr>
                                                <td class="fw-bold">Servicio:</td>
                                                <td>
                                                    <t t-if="factura.servicio == 'E'"><span class="rounded px-2 py-1" style="background-color:#FF6B6B;color:#fff;">Energía</span></t>
                                                    <t t-elif="factura.servicio == 'A'"><span class="rounded px-2 py-1" style="background-color:#4ECDC4;color:#fff;">Agua</span></t>
                                                    <t t-elif="factura.servicio == 'T'"><span class="rounded px-2 py-1" style="background-color:#45B7D1;color:#fff;">Telefonía</span></t>
                                                    <t t-elif="factura.servicio == 'I'"><span class="rounded px-2 py-1" style="background-color:#96CEB4;color:#fff;">Internet</span></t>
                                                    <t t-elif="factura.servicio == 'S'"><span class="rounded px-2 py-1" style="background-color:#9B59B6;color:#fff;">Sepelio</span></t>
                                                    <t t-elif="factura.servicio == 'N'"><span class="rounded px-2 py-1" style="background-color:#F39C12;color:#fff;">Nichos</span></t>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold">Período:</td>
                                                <td><t t-if="factura.periodo and len(factura.periodo) == 6"><t t-out="factura.periodo[4:6]"/>/<t t-out="factura.periodo[0:4]"/></t></td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold">Fecha:</td>
                                                <td><t t-esc="factura.fecha_emision" t-options="{'widget':'date'}"/></td>
                                            </tr>
                                            <tr>
                                                <td class="fw-bold">Vencimiento:</td>
                                                <td><t t-esc="factura.fecha_vencimiento" t-options="{'widget':'date'}"/></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6 text-end">
                                        <h2 class="text-danger">
                                            <t t-esc="factura.importe" t-options="{'widget':'monetary','display_currency':factura.env.company.currency_id}"/>
                                        </h2>
                                        <p class="text-muted mb-0">Importe a pagar</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Estado de deuda -->
                        <t t-if="factura.estado_pago == 'pagado'">
                            <div class="alert alert-success text-center">
                                <h4><i class="fa fa-check-circle"/> Factura pagada</h4>
                                <p class="mb-0">Esta factura ya fue abonada.</p>
                            </div>
                        </t>
                        <t t-elif="mas_90_dias">
                            <!-- Más de 90 días: contactar -->
                            <div class="card border-warning">
                                <div class="card-header bg-warning text-dark">
                                    <h5 class="mb-0"><i class="fa fa-exclamation-triangle"/> Deuda con más de 90 días</h5>
                                </div>
                                <div class="card-body text-center">
                                    <p class="fs-5">Su factura tiene <strong><t t-out="dias_deuda"/></strong> días de antigüedad.</p>
                                    <p>Para realizar el pago de esta factura, por favor contacte a nuestro equipo de cobranzas.</p>
                                    <div class="mt-4">
                                        <a href="tel:+5492464543900" class="btn btn-warning btn-lg me-2">
                                            <i class="fa fa-phone"/> Llamar: (2464) 54-3900
                                        </a>
                                        <a href="https://wa.me/5492464543900" class="btn btn-success btn-lg">
                                            <i class="fa fa-whatsapp"/> WhatsApp
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                        <t t-else="">
                            <!-- Menos de 90 días: opciones de pago -->
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h5 class="mb-0"><i class="fa fa-credit-card"/> Opciones de pago</h5>
                                </div>
                                <div class="card-body">
                                    <p class="fs-5">Su factura tiene <strong><t t-out="dias_deuda"/></strong> días de antigüedad.</p>
                                    <p>Seleccione una opción de pago:</p>
                                    <t t-if="error_provincianet and not pago_provincianet_bloqueado">
                                        <div class="alert alert-danger">
                                            <t t-esc="error_provincianet_msg or 'No se pudo generar el link de pago de Provincia NET.'"/>
                                            Intente nuevamente o use otra forma de pago.
                                        </div>
                                    </t>
                                    <t t-if="pago_provincianet_bloqueado">
                                        <div class="alert alert-warning" role="alert">
                                            <i class="fa fa-exclamation-triangle"/>
                                            <t t-esc="provincianet_vencido_msg"/>
                                            <span> Por este motivo la opción de Provincia NET no está disponible para esta factura.</span>
                                        </div>
                                    </t>

                                    <div class="row g-3 mt-3">
                                        <!-- Provincia NET -->
                                        <div class="col-12" t-if="not pago_provincianet_bloqueado">
                                            <div class="card border-primary">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-credit-card fa-3x text-primary mb-3"/>
                                                    <h5>Provincia NET</h5>
                                                    <p class="text-muted">Pague online con tarjeta o medios de Provincia NET</p>
                                                    <a t-attf-href="/my/factura/{{factura.id}}/provincianet" class="btn btn-primary btn-lg">
                                                        <i class="fa fa-external-link"/> Pagar ahora
                                                    </a>
                                                </div>
                                        </div>
                                    </div>

                                        <t t-set="codigo_billetera" t-value="factura.cod_pago_electronico_otros"/>
                                        <div class="col-12" t-if="codigo_billetera">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-6">
                                                            <div class="text-center text-md-start">
                                                                <i class="fa fa-qrcode fa-3x text-info mb-3"/>
                                                                <h5>Billeteras Virtuales</h5>
                                                                <p class="text-muted">Mercado Pago y otras billeteras</p>
                                                                <ul class="text-start">
                                                                    <li>Ingresar en cuenta y servicios / Pago de servicios</li>
                                                                    <li>Pagar una nueva cuenta</li>
                                                                    <li>Escanee o copie el código de barras que se muestra a continuación o el que figura en la factura</li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 text-center">
                                                            <img t-att-src="'/report/barcode/Code128/%s?width=400&amp;height=80&amp;quiet=0' % codigo_billetera"
                                                                 class="img-fluid mb-2" alt="Código de barras"/>
                                                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                                                <span class="font-monospace" id="codigo_billetera" t-esc="codigo_billetera"/>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                        onclick="navigator.clipboard.writeText(document.getElementById('codigo_billetera').innerText)">
                                                                    <i class="fa fa-copy"/> Copiar
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12" t-if="factura.servicio_id and factura.servicio_id.nro_usuario">
                                            <div class="card">
                                                <div class="card-body">
                                                    <div class="row align-items-center">
                                                        <div class="col-md-6">
                                                            <div class="text-center text-md-start">
                                                                <i class="fa fa-id-card-o fa-3x text-warning mb-3"/>
                                                                <h5>Cuenta DNI</h5>
                                                                <p class="text-muted">Pago de servicios desde la app</p>
                                                                <ul class="text-start">
                                                                    <li>Ingresar en pagar servicios</li>
                                                                    <li>Elegí servicios y pagos → adherir servicio</li>
                                                                    <li>Ente: Coop Electr. de Todd-internet y telecomunicaciones (podés buscar con "Todd")</li>
                                                                    <li>Luego ingresar el siguiente código Link</li>
                                                                </ul>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6 text-center">
                                                            <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap mb-3">
                                                                <span class="fs-3 font-monospace" id="codigo_dni" t-esc="factura.cod_pago_electronico"/>
                                                                <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                        onclick="navigator.clipboard.writeText(document.getElementById('codigo_dni').innerText)">
                                                                    <i class="fa fa-copy"/> Copiar
                                                                </button>
                                                            </div>
                                                            <p class="text-muted small mb-0">NOTA: En agenda de pagos van a ver los pendientes, lo cual no significa que lo deban. En servicio y pagos le mostrará los comprobantes pagos por este medio.</p>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="col-12" t-if="factura.servicio_id and factura.servicio_id.nro_usuario">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-link fa-3x text-primary mb-3"/>
                                                    <h5>Pagos Link</h5>
                                                    <p class="text-muted">Home banking Credicoop, BIP y otros bancos de la red Link</p>
                                                    <p class="mb-2"><strong>Cód. LINK PAGO</strong></p>
                                                    <div class="d-flex align-items-center justify-content-center gap-2 flex-wrap">
                                                        <span class="fs-3 font-monospace" id="codigo_link" t-esc="factura.cod_pago_electronico"/>
                                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                                onclick="navigator.clipboard.writeText(document.getElementById('codigo_link').innerText)">
                                                            <i class="fa fa-copy"/> Copiar
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Débito automático -->
                                        <div class="col-md-12">
                                            <div class="card h-100">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-calendar-check-o fa-3x text-success mb-3"/>
                                                    <h5>Débito Automático</h5>
                                                    <p class="text-muted">Si tiene débito automático, el monto se debitará en la fecha de vencimiento</p>
                                                    <div class="text-start bg-light p-3 rounded">
                                                        <p class="mb-1"><strong>Próximo débito:</strong> <t t-esc="factura.fecha_vencimiento" t-options="{'widget':'date'}"/></p>
                                                        <p class="mb-0"><strong>Monto:</strong> <t t-esc="factura.importe" t-options="{'widget':'monetary','display_currency':factura.env.company.currency_id}"/></p>
                                                    </div>
                                                    <div class="mt-3">
                                                        <a href="https://wa.me/5492474661343" class="btn btn-success" target="_blank" rel="noopener noreferrer">
                                                            <i class="fa fa-whatsapp"/> Consultar por WhatsApp
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Pago en sucursal -->
                                        <div class="col-12">
                                            <div class="card">
                                                <div class="card-body text-center">
                                                    <i class="fa fa-map-marker fa-3x text-info mb-3"/>
                                                    <h5>Pago en Sucursal</h5>
                                                    <p class="text-muted">Puede abonar en efectivo o con tarjeta en nuestras oficinas</p>
                                                    <p class="mb-0"><strong>Dirección:</strong>Ruta 8 km y Sarmiento - Todd</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="text-center mt-4">
                                        <a t-attf-href="/my/factura/{{factura.id}}/pdf" class="btn btn-outline-primary btn-lg">
                                            <i class="fa fa-file-pdf-o"/> Descargar Factura PDF
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>

                        <div class="text-center mt-4">
                            <a href="/my/facturas" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-left"/> Volver a Mis Facturas
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Acceso directo del portal: "Conexión y Seguridad" -> "Cambio de Contraseña" -->
    <template id="portal_home_security_card_password" name="Portal: acceso directo a cambio de contraseña" inherit_id="portal.portal_my_home">
        <!-- La tarjeta se localiza por su URL y no por su texto: el arch de las
             vistas de Odoo se traduce por idioma (arch_db), así que un xpath
             con text() deja de encontrar el nodo cuando el usuario no usa en_US
             y la vista entera falla al combinarse. -->
        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][contains(@t-value, '/my/security')]]/t[@t-set='title']" position="replace">
            <t t-set="title">Cambio de Contraseña</t>
        </xpath>
        <xpath expr="//t[@t-call='portal.portal_docs_entry'][t[@t-set='url'][contains(@t-value, '/my/security')]]/t[@t-set='text']" position="replace">
            <t t-set="text">Cambie su contraseña de acceso al portal</t>
        </xpath>
    </template>

    <!-- Acceso directo del portal: la tarjeta "Sus facturas" del inicio
         apunta a /my/facturas (facturas de todd.factura) en lugar de a la
         vista de facturas de contabilidad. -->
    <template id="portal_home_invoice_card_link" name="Portal: tarjeta de facturas hacia Mis Facturas" inherit_id="account.portal_my_home_invoice">
        <xpath expr="//div[@id='portal_client_category']//t[@t-set='url'][contains(@t-value, '/my/invoices')]" position="replace">
            <t t-set="url" t-value="'/my/facturas'"/>
        </xpath>
    </template>

    <!-- Acceso directo del portal: tarjeta hacia el Webmail institucional.
         Se inserta DENTRO de #portal_client_category, el mismo 'row' que
         contiene la tarjeta de facturas (account.portal_my_home_invoice),
         para que ambas queden lado a lado y no en una fila inferior.
         priority=99 asegura aplicar despues de la vista de facturas (30) y
         de portal_home_invoice_card_link, de modo que la tarjeta de facturas
         ya este en el arch combinado cuando se haga el xpath. -->
    <template id="portal_home_webmail_card" name="Portal: tarjeta de Webmail" inherit_id="portal.portal_my_home" priority="99">
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <!-- A proposito el archivo se llama email.svg y NO mail.svg:
                     la URL /static/src/img/mail.svg quedo cacheada en
                     Cloudflare (max-age=604800) con un JPEG servido como
                     image/svg+xml. Sin acceso a la CDN, la unica forma de
                     invalidar esa entrada es cambiar la URL. No volver a
                     usar mail.svg. Si en el futuro se cambia el contenido
                     del icono, usar un nombre o un query nuevo (email.svg?v=N)
                     para evitar el mismo problema. -->
                <t t-set="icon" t-value="'/todd_facturas/static/src/img/email.svg'"/>
                <t t-set="title">Webmail</t>
                <t t-set="text">Acceda a su correo</t>
                <t t-set="url" t-value="'https://mail.todd.com.ar/mail/'"/>
                <t t-set="config_card" t-value="True"/>
            </t>
        </xpath>
    </template>
    <!-- /my/security: dejar visible únicamente el cambio de contraseña -->
    <template id="portal_my_security_password_only" name="Portal: solo cambio de contraseña" inherit_id="portal.portal_my_security">
        <xpath expr="//t[@t-set='additional_title']" position="replace">
            <t t-set="additional_title">Cambio de Contraseña</t>
        </xpath>
        <xpath expr="//div[hasclass('o_portal_security_body')]//h3" position="replace">
            <h3 class="my-0">Cambio de Contraseña</h3>
        </xpath>
        <xpath expr="//section[@name='portal_change_password']" position="before">
            <style>
                /* Ocultar cualquier otra sección de la página (revocar sesiones,
                   2FA, passkeys, API keys, baja de cuenta, etc.) */
                .o_portal_security_body section:not([name='portal_change_password']) {
                    display: none !important;
                }
                /* El título de la sección repite el título de la página */
                .o_portal_security_body section[name='portal_change_password'] > h4 {
                    display: none !important;
                }
            </style>
        </xpath>
        <xpath expr="//section[@name='portal_revoke_all_devices_popup']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//section[@t-if='debug and allow_api_keys']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
        <xpath expr="//section[@groups='base.group_portal']" position="attributes">
            <attribute name="t-if">False</attribute>
        </xpath>
    </template>
</odoo>
