<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reemplazar link de facturas en el portal home -->
    <template id="portal_home_custom" name="Portal Home Custom" inherit_id="portal.portal_my_home">
        <xpath expr="//a[@href='/my/invoices']" position="replace">
            <a href="/my/facturas" title="Mis Facturas" class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                <div class="o_portal_icon d-block align-self-start">
                    <img src="/account/static/src/img/bill.svg" loading="lazy" style=""/>
                </div>
                <div class="">
                    <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                        <span>Mis Facturas</span>
                    </div>
                    <div class="opacity-75">
                        Visualice y descargue sus facturas
                    </div>
                </div>
            </a>
        </xpath>
    </template>

    <template id="portal_facturas" name="Mis Facturas">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>
            <t t-if="facturas">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Servicio</th>
                            <th>Período</th>
                            <th>Fecha</th>
                            <th>Vencimiento</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="facturas" t-as="f">
                            <tr>
                                <td><t t-esc="f.name"/></td>
                                <td><t t-if="f.todd_servicio == 'E'">Energía</t><t t-elif="f.todd_servicio == 'A'">Agua</t><t t-elif="f.todd_servicio == 'T'">Telefonía</t><t t-elif="f.todd_servicio == 'I'">Internet</t><t t-elif="f.todd_servicio == 'S'">Sepelio</t><t t-elif="f.todd_servicio == 'N'">Nichos</t></td>
                                <td><t t-if="f.todd_periodo and len(f.todd_periodo) == 6"><t t-out="f.todd_periodo[4:6]"/>/<t t-out="f.todd_periodo[0:4]"/></t></td>
                                <td><t t-esc="f.invoice_date" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.invoice_date_due" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.amount_total" t-options="{'widget':'monetary','display_currency':f.currency_id}"/></td>
                                <td>
                                    <span t-if="f.todd_estado_pago == 'pagado'" class="badge bg-success">Pagado</span>
                                    <span t-else="" class="badge bg-danger">Adeudado</span>
                                </td>
                                <td>
                                    <t t-if="f.todd_pdf_disponible">
                                        <a t-attf-href="/my/factura/{{f.id}}/pdf" class="btn btn-sm btn-primary">PDF</a>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <p class="text-center">No tienes facturas.</p>
            </t>
        </t>
    </template>
</odoo>