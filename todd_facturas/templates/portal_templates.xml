<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_invoices_custom" name="Portal Invoices Custom" inherit_id="account.portal_my_invoices">
        <xpath expr="//thead//th[last()]" position="after">
            <th>Servicio</th>
            <th>Período</th>
        </xpath>
        <xpath expr="//tbody//t[@t-foreach='invoices']//td[last()]" position="after">
            <td><t t-esc="invoice.todd_servicio"/></td>
            <td><t t-esc="invoice.todd_periodo"/></td>
        </xpath>
    </template>

    <template id="portal_facturas" name="Mis Facturas">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar"/>
            <t t-if="facturas">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Factura</th>
                            <th>Servicio</th>
                            <th>Período</th>
                            <th>Fecha</th>
                            <th>Vencimiento</th>
                            <th>Total</th>
                            <th>Estado</th>
                            <th>PDF</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="facturas" t-as="f">
                            <tr>
                                <td><t t-esc="f.name"/></td>
                                <td><t t-esc="f.todd_servicio"/></td>
                                <td><t t-esc="f.todd_periodo"/></td>
                                <td><t t-esc="f.invoice_date" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.invoice_date_due" t-options="{'widget':'date'}"/></td>
                                <td><t t-esc="f.amount_total" t-options="{'widget':'monetary','display_currency':f.currency_id}"/></td>
                                <td>
                                    <span t-if="f.todd_estado_pago == 'pagado'" class="badge bg-success">Pagado</span>
                                    <span t-else="" class="badge bg-danger">Adeudado</span>
                                </td>
                                <td>
                                    <t t-if="f.todd_pdf_disponible">
                                        <a t-attf-href="/my/factura/{{f.id}}/pdf" class="btn btn-sm btn-primary">PDF</a>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </t>
            <t t-else="">
                <p class="text-center">No tienes facturas.</p>
            </t>
        </t>
    </template>
</odoo>