<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="login_dni_legend" name="Login: leyenda DNI" inherit_id="web.login">
        <xpath expr="//div[hasclass('field-login')]" position="before">
            <div class="alert alert-info small mb-3" role="note">
                <strong>Primer ingreso:</strong>
		use su número de DNI/CUIT como usuario y contraseña.
            </div>
        </xpath>

        <!-- El usuario del portal es el DNI/CUIT, no el correo electrónico -->
        <xpath expr="//div[hasclass('field-login')]/label" position="replace">
            <label for="login" class="form-label d-flex justify-content-between">DNI/CUIT</label>
        </xpath>

        <xpath expr="//div[hasclass('field-login')]/input" position="attributes">
            <attribute name="placeholder">DNI/CUIT</attribute>
        </xpath>
    </template>

    <!-- Los usuarios del portal entran con DNI/CUIT, por lo que no tienen
         passkey ni pueden restablecer la contraseña por correo. Se quitan:
           * "- o -" y "Usa una llave de acceso": ambos salen de
             web.login_oauth. auth_passkey (auto_instalado) agrega un botón a
             auth_btns y el separador "- or -" sólo se dibuja cuando auth_btns
             no está vacío. Al eliminar la llamada desaparecen los dos.
           * "Restablecer contraseña": lo agrega auth_signup.login, que llega
             al módulo vía portal -> auth_signup.
         priority=99 es necesario porque esos nodos los insertan otras vistas
         heredadas (auth_signup.login=16, auth_passkey_login=32); sin esta
         prioridad el xpath no encontraría el enlace y fallaría el upgrade. -->
    <template id="login_clean" name="Login: sin passkey ni restablecer contraseña"
              inherit_id="web.login" priority="99">
        <xpath expr="//t[@t-call='web.login_oauth']" position="replace"/>
        <xpath expr="//a[@t-if='reset_password_enabled']" position="replace"/>
    </template>
</odoo>
