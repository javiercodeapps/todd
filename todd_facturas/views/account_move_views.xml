<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_todd" model="ir.ui.view">
        <field name="name">account.move.form.todd</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoice_tab']" position="after">
                <page string="Todd" name="todd">
                    <group>
                        <field name="todd_archivo_pdf"/>
                        <field name="todd_nro_socio"/>
                        <field name="todd_servicio"/>
                        <field name="todd_periodo"/>
                        <field name="todd_pdf_disponible" readonly="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>