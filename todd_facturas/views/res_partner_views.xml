<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_todd" model="ir.ui.view">
        <field name="name">res.partner.form.todd</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Todd" name="todd">
                    <group>
                        <field name="todd_nro_socio"/>
                        <field name="todd_nro_usuario"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>