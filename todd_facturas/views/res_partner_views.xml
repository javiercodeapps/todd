<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_todd" model="ir.ui.view">
        <field name="name">res.partner.form.todd</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_ver_servicios"
                        icon="fa-wrench"
                        invisible="servicios_count == 0">
                    <field name="servicios_count" widget="statinfo" string="Servicios"/>
                </button>
                <button class="oe_stat_button" type="object"
                        name="action_ver_facturas"
                        icon="fa-file-text-o"
                        invisible="facturas_todd_count == 0">
                    <field name="facturas_todd_count" widget="statinfo" string="Facturas Todd"/>
                </button>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="Todd" name="todd">
                    <group>
                        <group string="Servicios Todd">
                            <field name="servicio_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="tipo"/>
                                    <field name="nro_socio"/>
                                    <field name="nro_usuario"/>
                                    <field name="nombre_usuario"/>
                                    <field name="domicilio"/>
                                </list>
                            </field>
                        </group>
                    </group>
                    <button name="action_crear_usuario_portal" string="Crear Usuario Portal"
                            type="object" class="btn-primary"
                            invisible="vat == False"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
