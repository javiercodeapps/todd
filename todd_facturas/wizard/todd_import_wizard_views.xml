<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_todd_import_form" model="ir.ui.view">
        <field name="name">todd.import.wizard.form</field>
        <field name="model">todd.import.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="archivo_txt" filename="archivo_nombre"/>
                    <field name="archivo_nombre" invisible="1"/>
                    <field name="journal_id"/>
                    <field name="copiar_pdfs"/>
                </group>
                <group invisible="state != 'done'">
                    <field name="total" readonly="1"/>
                    <field name="ok" readonly="1"/>
                    <field name="errores" readonly="1"/>
                    <field name="log" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_importar" string="Importar" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button string="Cerrar" special="cancel" invisible="state != 'done'"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_todd_import_wizard" model="ir.actions.act_window">
        <field name="name">Importar TXT</field>
        <field name="res_model">todd.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>